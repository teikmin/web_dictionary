---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogView from '../../components/CatalogView.astro';

export async function getStaticPaths() {
  const clients = await getCollection('clients');
  return clients.map((c) => ({
    params: { client: c.data.id },
    props: { client: c.data },
  }));
}

const { client } = Astro.props;
---

<BaseLayout
  title={`${client.name} — Compatible MCP Servers & Agent Skills`}
  description={client.description}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6">
      <a href="/" class="hover:text-slate-900">Home</a>
      <span>/</span>
      <a href="/catalog" class="hover:text-slate-900">Catalog</a>
      <span>/</span>
      <span class="text-slate-800 font-medium">{client.name}</span>
    </nav>

    <!-- Client Setup Header -->
    <header class="border-b border-slate-200 pb-8 mb-4">
      <div class="flex items-center gap-3 mb-2">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          {client.name}
        </h1>
      </div>

      <p class="text-sm text-slate-600 max-w-3xl mb-6 leading-relaxed">
        {client.tagline}
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 p-4 rounded-xl bg-white border border-slate-200 shadow-xs text-xs">
        <div>
          <span class="text-slate-500 block mb-0.5">Configuration Format:</span>
          <span class="text-blue-700 font-mono font-semibold uppercase">{client.configFormat}</span>
        </div>
        <div>
          <span class="text-slate-500 block mb-0.5">Default Config Path:</span>
          <span class="text-slate-800 font-mono">{client.configPath || 'Standard client path'}</span>
        </div>
        <div>
          <span class="text-slate-500 block mb-0.5">Official Website:</span>
          {client.website ? (
            <a href={client.website} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline font-medium">
              {client.website}
            </a>
          ) : (
            <span class="text-slate-400">N/A</span>
          )}
        </div>
      </div>
    </header>
  </div>

  <CatalogView
    initialClient={client.id}
    pageTitle=""
    pageDescription=""
  />
</BaseLayout>
