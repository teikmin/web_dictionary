---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryCard from '../../components/EntryCard.astro';
import { getAllEntries } from '../../lib/entries';

export async function getStaticPaths() {
  const clients = await getCollection('clients');
  return clients.map((c) => ({
    params: { client: c.data.id },
    props: { client: c.data },
  }));
}

const { client } = Astro.props;
const allEntries = await getAllEntries();
---

<BaseLayout
  title={`${client.name} — Compatible MCP Servers & Agent Skills`}
  description={client.description}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <header class="border-b border-slate-800 pb-8 mb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-3xl">
          {client.id === 'claude-code' ? '⚡' : client.id === 'codex' ? '🤖' : '🌌'}
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          {client.name}
        </h1>
      </div>

      <p class="text-lg text-slate-300 max-w-3xl mb-6">
        {client.tagline}
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 p-4 rounded-xl bg-slate-900 border border-slate-800 text-xs">
        <div>
          <span class="text-slate-500 block">Configuration Format:</span>
          <span class="text-sky-400 font-mono font-medium uppercase">{client.configFormat}</span>
        </div>
        <div>
          <span class="text-slate-500 block">Default Config Path:</span>
          <span class="text-slate-200 font-mono">{client.configPath || 'Standard client path'}</span>
        </div>
        <div>
          <span class="text-slate-500 block">Official Website:</span>
          {client.website ? (
            <a href={client.website} target="_blank" rel="noopener noreferrer" class="text-blue-400 hover:underline">
              {client.website}
            </a>
          ) : (
            <span class="text-slate-400">N/A</span>
          )}
        </div>
      </div>
    </header>

    <!-- Catalog for this client -->
    <div>
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-white">
          All Compatible MCP Servers &amp; Skills ({allEntries.length})
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {allEntries.map((entry) => (
          <EntryCard entry={entry} />
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
