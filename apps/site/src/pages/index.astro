---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryCard from '../components/EntryCard.astro';
import SearchBox from '../components/SearchBox.astro';
import { getAllEntries, getAllMcp, getAllSkills, getCatalogState } from '../lib/entries';
import { getCollection } from 'astro:content';

const [allEntries, mcpServers, agentSkills, categories, clients] = await Promise.all([
  getAllEntries(),
  getAllMcp(),
  getAllSkills(),
  getCollection('categories'),
  getCollection('clients'),
]);

const catalogState = getCatalogState();

// Row 1: Most Popular (by stars)
const popularRow = [...allEntries]
  .sort((a, b) => (b.data.signals?.stars || 0) - (a.data.signals?.stars || 0))
  .slice(0, 4);

// Row 2: Recently Updated (by last commit)
const updatedRow = [...allEntries]
  .sort((a, b) => (new Date(b.data.signals?.last_commit || 0).getTime()) - (new Date(a.data.signals?.last_commit || 0).getTime()))
  .slice(0, 4);

// Row 3: Official Vendor Tools
const officialRow = [...allEntries]
  .filter((e) => e.data.source?.official_vendor)
  .sort((a, b) => (b.data.signals?.stars || 0) - (a.data.signals?.stars || 0))
  .slice(0, 4);

// Row 4: Newest Added (by first_seen)
const newestRow = [...allEntries]
  .sort((a, b) => (new Date(b.data.first_seen).getTime()) - (new Date(a.data.first_seen).getTime()))
  .slice(0, 4);

// Calculate category counts
const categoryCounts: Record<string, number> = {};
for (const e of allEntries) {
  for (const cat of e.data.categories) {
    categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
  }
}
---

<BaseLayout>
  <!-- Browse Hub Top Section (§5.2) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-10">
    <!-- Short intro banner only, no marketing hero (§5.2 item 2) -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 mb-8 border-b border-slate-200">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Browse AI Agent Tools &amp; Skills
        </h1>
        <p class="text-xs text-slate-600 mt-1">
          Open catalog of <strong>{allEntries.length} tools</strong> ({mcpServers.length} MCP servers, {agentSkills.length} agent skills). Refreshed on {catalogState.formattedDate}.
        </p>
      </div>

      <!-- Quick Client Switcher -->
      <div class="flex items-center gap-2">
        <span class="text-xs text-slate-500 font-medium hidden sm:inline">Clients:</span>
        {clients.map((c) => (
          <a
            href={`/client/${c.data.id}`}
            class="px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-xs text-slate-700 hover:text-slate-900 transition-colors shadow-xs"
          >
            {c.data.name}
          </a>
        ))}
      </div>
    </div>

    <!-- Search Box (always visible) -->
    <div class="mb-10 max-w-3xl">
      <SearchBox />
    </div>

    <!-- 1. Browse by Type (§5.2 item 4) -->
    <div class="mb-12">
      <h2 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-4">
        Browse by Type
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <a
          href="/catalog?type=mcp_server"
          class="p-6 rounded-2xl border border-blue-200 bg-blue-50/40 hover:bg-blue-50/70 hover:border-blue-300 transition-all group shadow-xs"
        >
          <div class="flex items-center justify-between mb-2">
            <span class="px-2.5 py-0.5 rounded text-xs font-semibold uppercase tracking-wider bg-blue-100/80 text-blue-800 border border-blue-200">
              MCP Servers
            </span>
            <span class="font-mono text-sm text-blue-600 font-bold group-hover:translate-x-1 transition-transform">
              {mcpServers.length} servers &rarr;
            </span>
          </div>
          <p class="text-sm text-slate-600 mt-2 leading-relaxed">
            Standardized servers exposing databases, browser automation, filesystem access, and API integrations via Model Context Protocol.
          </p>
        </a>

        <a
          href="/catalog?type=agent_skill"
          class="p-6 rounded-2xl border border-teal-200 bg-teal-50/40 hover:bg-teal-50/70 hover:border-teal-300 transition-all group shadow-xs"
        >
          <div class="flex items-center justify-between mb-2">
            <span class="px-2.5 py-0.5 rounded text-xs font-semibold uppercase tracking-wider bg-teal-100/80 text-teal-800 border border-teal-200">
              Agent Skills
            </span>
            <span class="font-mono text-sm text-teal-700 font-bold group-hover:translate-x-1 transition-transform">
              {agentSkills.length} skills &rarr;
            </span>
          </div>
          <p class="text-sm text-slate-600 mt-2 leading-relaxed">
            Composable skills and task instructions packaged in SKILL.md specs for Claude Code, OpenAI Codex, and Google Antigravity.
          </p>
        </a>
      </div>
    </div>

    <!-- 2. Browse by Category (§5.2 item 3) -->
    <div class="mb-14">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xs font-bold text-slate-500 uppercase tracking-wider">
          Browse by Category
        </h2>
        <a href="/catalog" class="text-xs font-semibold text-blue-600 hover:underline">
          View all categories in catalog &rarr;
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3.5">
        {categories.map((cat) => {
          const count = categoryCounts[cat.data.id] || 0;
          return (
            <a
              href={`/catalog?category=${cat.data.id}`}
              class="p-4 rounded-xl border border-slate-200 bg-white hover:border-slate-300 hover:bg-slate-50/80 transition-all group shadow-xs"
            >
              <div class="flex items-center justify-between mb-1">
                <span class="font-semibold text-sm text-slate-900 group-hover:text-blue-600 transition-colors">
                  {cat.data.name}
                </span>
                <span class="text-xs font-mono text-slate-500 font-medium">
                  {count}
                </span>
              </div>
              <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
                {cat.data.description}
              </p>
            </a>
          );
        })}
      </div>
    </div>

    <!-- 3. Rows (§5.2 item 5): Popular, Recently Updated, Official, New -->
    <div class="space-y-12 pt-4 border-t border-slate-200">
      <!-- Most Popular Row -->
      <div>
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-lg font-bold text-slate-900">Most Popular</h2>
            <p class="text-xs text-slate-500">Widely adopted tools ranked by GitHub community stars</p>
          </div>
          <a href="/catalog?sort=popular" class="text-xs font-semibold text-blue-600 hover:underline">
            See all popular &rarr;
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {popularRow.map((entry) => (
            <EntryCard entry={entry} />
          ))}
        </div>
      </div>

      <!-- Recently Updated Row -->
      <div>
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-lg font-bold text-slate-900">Recently Updated</h2>
            <p class="text-xs text-slate-500">Actively maintained tools with fresh repository commits</p>
          </div>
          <a href="/catalog?sort=updated" class="text-xs font-semibold text-blue-600 hover:underline">
            See all recently updated &rarr;
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {updatedRow.map((entry) => (
            <EntryCard entry={entry} />
          ))}
        </div>
      </div>

      <!-- Official Vendors Row -->
      {officialRow.length > 0 && (
        <div>
          <div class="flex items-center justify-between mb-4">
            <div>
              <h2 class="text-lg font-bold text-slate-900">Official Vendor Tools</h2>
              <p class="text-xs text-slate-500">Servers published and supported directly by primary platform providers</p>
            </div>
            <a href="/catalog?official=true" class="text-xs font-semibold text-blue-600 hover:underline">
              See all official tools &rarr;
            </a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {officialRow.map((entry) => (
              <EntryCard entry={entry} />
            ))}
          </div>
        </div>
      )}

      <!-- Newest Added Row -->
      <div>
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-lg font-bold text-slate-900">Newest Added</h2>
            <p class="text-xs text-slate-500">Tools and skills newly joined to the directory catalog</p>
          </div>
          <a href="/catalog?sort=newest" class="text-xs font-semibold text-blue-600 hover:underline">
            See all newest &rarr;
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {newestRow.map((entry) => (
            <EntryCard entry={entry} />
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
