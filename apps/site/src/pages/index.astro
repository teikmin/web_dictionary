---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBox from '../components/SearchBox.astro';
import EntryCard from '../components/EntryCard.astro';
import { getAllMcp, getAllSkills } from '../lib/entries';
import { getCollection } from 'astro:content';

const [mcpServers, agentSkills, clients, categories] = await Promise.all([
  getAllMcp(),
  getAllSkills(),
  getCollection('clients'),
  getCollection('categories'),
]);

const topMcp = mcpServers.slice(0, 8);
const topSkills = agentSkills.slice(0, 8);
---

<BaseLayout>
  <!-- Hero Section -->
  <section class="relative overflow-hidden py-16 md:py-24 border-b border-slate-800/80 bg-gradient-to-b from-slate-900/50 via-slate-950 to-slate-950">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-medium border border-blue-500/30 bg-blue-950/40 text-blue-300 mb-6">
        <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
        <span>Curated &amp; Verified for Coding Agents</span>
      </div>

      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-white mb-6">
        MCP Servers &amp; Agent Skills <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-blue-400 via-indigo-300 to-purple-400 bg-clip-text text-transparent">
          with 1-Click Launch Configs
        </span>
      </h1>

      <p class="text-base md:text-lg text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed">
        Autonomous coding agents need verified tools. Search {mcpServers.length} MCP servers and {agentSkills.length} agent skills, with verified configs for <span class="text-slate-200 font-medium">Claude Code</span>, <span class="text-slate-200 font-medium">Codex</span>, and <span class="text-slate-200 font-medium">Antigravity</span>.
      </p>

      <!-- Search Box with Pagefind -->
      <SearchBox class="mb-8" />

      <!-- Client Quick Pills -->
      <div class="flex flex-wrap items-center justify-center gap-3 pt-4">
        <span class="text-xs text-slate-500 uppercase tracking-wider font-semibold">Clients:</span>
        {clients.map((c) => (
          <a
            href={`/client/${c.data.id}`}
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-slate-800 bg-slate-900/80 hover:bg-slate-800 hover:border-slate-700 text-xs text-slate-300 hover:text-white transition-all shadow-xs"
          >
            <span>{c.data.id === 'claude-code' ? '⚡' : c.data.id === 'codex' ? '🤖' : '🌌'}</span>
            <span class="font-medium">{c.data.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Categories Bar -->
  <section class="border-b border-slate-800/80 bg-slate-900/30 py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 overflow-x-auto py-1 scrollbar-none">
        <span class="text-xs text-slate-500 font-medium whitespace-nowrap mr-2">Categories:</span>
        {categories.map((cat) => (
          <a
            href={`/category/${cat.data.id}`}
            class="px-3 py-1 rounded-md text-xs font-medium border border-slate-800/80 bg-slate-900/50 hover:bg-slate-800 hover:text-white text-slate-300 transition-colors whitespace-nowrap"
          >
            {cat.data.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Catalog Main -->
  <section id="catalog" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
    <!-- MCP Servers -->
    <div>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
          <h2 class="text-2xl font-bold text-white flex items-center gap-2.5">
            <span class="text-cyan-400">🔌</span>
            <span>Top Curated MCP Servers</span>
            <span class="text-xs px-2.5 py-0.5 rounded-full bg-cyan-950/60 border border-cyan-800/60 text-cyan-300 font-mono">
              {mcpServers.length} verified
            </span>
          </h2>
          <p class="text-sm text-slate-400 mt-1">
            Model Context Protocol servers providing database connections, browser automation, and developer tools.
          </p>
        </div>

        <a
          href="/mcp"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-cyan-400 hover:text-cyan-300 transition-colors shrink-0"
        >
          <span>View all {mcpServers.length} MCP servers</span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {topMcp.map((entry) => (
          <EntryCard entry={entry} />
        ))}
      </div>
    </div>

    <!-- Agent Skills -->
    <div>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
          <h2 class="text-2xl font-bold text-white flex items-center gap-2.5">
            <span class="text-purple-400">🧠</span>
            <span>Top Curated Agent Skills</span>
            <span class="text-xs px-2.5 py-0.5 rounded-full bg-purple-950/60 border border-purple-800/60 text-purple-300 font-mono">
              {agentSkills.length} verified
            </span>
          </h2>
          <p class="text-sm text-slate-400 mt-1">
            Verifiable agent instructions with <code class="text-xs bg-slate-900 px-1 py-0.5 rounded text-purple-300">SKILL.md</code> definitions.
          </p>
        </div>

        <a
          href="/skills"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-purple-400 hover:text-purple-300 transition-colors shrink-0"
        >
          <span>View all {agentSkills.length} skills</span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {topSkills.map((entry) => (
          <EntryCard entry={entry} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
