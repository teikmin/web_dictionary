---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogView from '../../components/CatalogView.astro';
import { getAllSkills } from '../../lib/entries';

const agentSkills = await getAllSkills();
---

<BaseLayout
  title="All Agent Skills — AI Tools Hub"
  description={`Browse ${agentSkills.length} Agent Skills with instructions and install paths for Claude Code, Codex, and Antigravity.`}
>
  <CatalogView
    initialType="agent_skill"
    pageTitle="All Agent Skills"
    pageDescription={`Browse ${agentSkills.length} Agent Skills providing prompt instructions, workflows, and task execution capabilities.`}
  />
</BaseLayout>
