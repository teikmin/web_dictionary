---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogView from '../../components/CatalogView.astro';

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  return categories.map((cat) => ({
    params: { category: cat.data.id },
    props: { category: cat.data },
  }));
}

const { category } = Astro.props;
---

<BaseLayout
  title={`${category.name} — MCP Servers & Agent Skills`}
  description={category.description}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-2">
      <a href="/" class="hover:text-slate-300">Home</a>
      <span>/</span>
      <a href="/catalog" class="hover:text-slate-300">Catalog</a>
      <span>/</span>
      <span class="text-slate-300 font-medium">{category.name}</span>
    </nav>
  </div>

  <CatalogView
    initialCategory={category.id}
    pageTitle={category.name}
    pageDescription={category.description}
  />
</BaseLayout>
