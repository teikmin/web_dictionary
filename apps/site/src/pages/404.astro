---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found — AI Tools Hub" indexed={false}>
  <div class="max-w-2xl mx-auto px-4 py-24 text-center">
    <div class="text-6xl font-extrabold text-blue-600 font-mono mb-4">404</div>
    <h1 class="text-2xl font-bold text-slate-900 mb-3">Resource Not Found</h1>
    <p class="text-sm text-slate-600 mb-8">
      The MCP server, Agent Skill, or page you were looking for doesn't exist or may have been renamed in a recent catalog update.
    </p>
    <a
      href="/"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium transition-colors shadow-xs"
    >
      <span>&larr; Return to Catalog</span>
    </a>
  </div>
</BaseLayout>
