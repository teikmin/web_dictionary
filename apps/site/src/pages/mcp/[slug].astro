---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConfigTabs from '../../components/ConfigTabs.astro';
import ConfidenceBadge from '../../components/ConfidenceBadge.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import SignalStats from '../../components/SignalStats.astro';

export async function getStaticPaths() {
  const mcpEntries = await getCollection('mcp');
  return mcpEntries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);
---

<BaseLayout
  title={`${data.name} — MCP Server for Claude Code, Codex, Antigravity`}
  description={data.tagline || `Launch configuration for ${data.name} MCP server.`}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6">
      <a href="/" class="hover:text-slate-300">Home</a>
      <span>/</span>
      <a href="/#catalog" class="hover:text-slate-300">MCP Servers</a>
      <span>/</span>
      <span class="text-slate-300 font-medium">{data.name}</span>
    </nav>

    <!-- Header -->
    <header class="border-b border-slate-800 pb-8">
      <div class="flex flex-wrap items-center gap-3 mb-3">
        <span class="px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider rounded bg-cyan-950/80 text-cyan-300 border border-cyan-800/60">
          MCP Server
        </span>
        <ConfidenceBadge confidence={data.launch.confidence} />
        <StatusBadge status={data.status} />
      </div>

      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
            {data.name}
          </h1>
          <p class="text-base text-slate-400 mt-2 max-w-2xl">
            {data.tagline || 'No tagline provided.'}
          </p>
        </div>

        <a
          href={`https://github.com/${data.source.repo}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-900 border border-slate-700 hover:border-slate-600 hover:bg-slate-800 text-sm font-medium text-slate-200 transition-colors shrink-0"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span>View on GitHub</span>
        </a>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-4 text-xs text-slate-400">
        <SignalStats
          stars={data.signals.stars}
          lastCommit={data.signals.last_commit}
          percentile={data.quality_percentile}
          officialVendor={data.source.official_vendor}
        />
        {data.source.license && (
          <span class="inline-flex items-center gap-1 font-mono text-slate-300">
            <span>License:</span>
            <span class="text-white font-medium">{data.source.license}</span>
          </span>
        )}
      </div>
    </header>

    <!-- 1-Click Launch Configuration Tabs -->
    <section class="py-8">
      <h2 class="text-xl font-bold text-white mb-2">1-Click Launch Configuration</h2>
      <p class="text-xs text-slate-400 mb-4">
        Pre-formatted launch commands and snippet files ready to copy into your agent's config.
      </p>

      <ConfigTabs
        type="mcp_server"
        name={data.name}
        launchSpec={data.launch}
      />
    </section>

    <!-- Environment Variables (if any) -->
    {data.launch.env_vars && data.launch.env_vars.length > 0 && (
      <section class="py-6 border-t border-slate-800">
        <h3 class="text-lg font-semibold text-white mb-3">Required Environment Variables</h3>
        <div class="overflow-x-auto rounded-lg border border-slate-800">
          <table class="w-full text-left text-xs text-slate-300 font-mono">
            <thead class="bg-slate-900 border-b border-slate-800 text-slate-400 uppercase text-[10px]">
              <tr>
                <th class="p-3">Variable</th>
                <th class="p-3">Status</th>
                <th class="p-3">Description</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/60 bg-slate-950">
              {data.launch.env_vars.map((v) => (
                <tr>
                  <td class="p-3 font-semibold text-sky-400">{v.name}</td>
                  <td class="p-3">
                    <span class:list={[
                      'px-2 py-0.5 rounded text-[10px]',
                      v.required ? 'bg-amber-950 text-amber-300 border border-amber-800/60' : 'bg-slate-800 text-slate-400'
                    ]}>
                      {v.required ? 'Required' : 'Optional'}
                    </span>
                  </td>
                  <td class="p-3 text-slate-400 font-sans">{v.description || 'Configured via environment variable.'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <!-- Categories & Metadata -->
    <section class="py-6 border-t border-slate-800">
      <h3 class="text-lg font-semibold text-white mb-3">Categories &amp; Provenance</h3>
      <div class="flex flex-wrap gap-2 mb-6">
        {data.categories.map((cat: string) => (
          <a
            href={`/category/${cat}`}
            class="px-3 py-1 rounded-md text-xs bg-slate-900 border border-slate-800 hover:border-slate-700 text-slate-300 hover:text-white transition-colors"
          >
            {cat}
          </a>
        ))}
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 p-4 rounded-lg bg-slate-900/40 border border-slate-800/80 text-xs">
        <div>
          <span class="text-slate-500 block">Selection Reason:</span>
          <span class="text-slate-300 font-mono font-medium">{data.selection_reason}</span>
        </div>
        <div>
          <span class="text-slate-500 block">First Discovered:</span>
          <span class="text-slate-300 font-mono">{new Date(data.first_seen).toLocaleDateString()}</span>
        </div>
        <div>
          <span class="text-slate-500 block">Catalog Last Updated:</span>
          <span class="text-slate-300 font-mono">{new Date(data.last_updated).toLocaleDateString()}</span>
        </div>
      </div>
    </section>

    <!-- Details / Body -->
    <article class="prose prose-invert prose-sm max-w-none py-8 border-t border-slate-800 text-slate-300">
      <Content />
    </article>
  </div>
</BaseLayout>
