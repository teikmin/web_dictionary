---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogView from '../../components/CatalogView.astro';
import { getAllMcp } from '../../lib/entries';

const mcpServers = await getAllMcp();
---

<BaseLayout
  title="All MCP Servers — AI Tools Hub"
  description={`Browse ${mcpServers.length} Model Context Protocol servers with install steps for Claude Code, Codex, and Antigravity.`}
>
  <CatalogView
    initialType="mcp_server"
    pageTitle="All MCP Servers"
    pageDescription={`Browse ${mcpServers.length} Model Context Protocol servers providing database connectors, API bridges, and system tools with launch configs.`}
  />
</BaseLayout>
