---
interface Props {
  text: string;
  label?: string;
  class?: string;
}

const { text, label = 'Copy', class: className = '' } = Astro.props;
---

<button
  type="button"
  class:list={[
    'copy-btn inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-medium rounded-md border border-slate-200 bg-white hover:bg-slate-50 hover:border-slate-300 text-slate-700 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 shadow-xs cursor-pointer',
    className,
  ]}
  data-text={text}
  aria-label={label}
>
  <svg class="copy-icon w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
  </svg>
  <svg class="check-icon w-3.5 h-3.5 text-emerald-400 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
  </svg>
  <span class="btn-text">{label}</span>
</button>

<script>
  function setupCopyButtons() {
    document.querySelectorAll('.copy-btn').forEach((btn) => {
      if (btn.hasAttribute('data-has-listener')) return;
      btn.setAttribute('data-has-listener', 'true');

      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-text') || '';
        const icon = btn.querySelector('.copy-icon');
        const check = btn.querySelector('.check-icon');
        const label = btn.querySelector('.btn-text');
        const originalText = label?.textContent || 'Copy';

        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(text);
          } else {
            const textArea = document.createElement('textarea');
            textArea.value = text;
            textArea.style.position = 'fixed';
            textArea.style.left = '-999999px';
            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();
            (document as { execCommand?: (cmd: string) => boolean }).execCommand?.('copy');
            textArea.remove();
          }

          if (icon && check && label) {
            icon.classList.add('hidden');
            check.classList.remove('hidden');
            label.textContent = 'Copied!';
            setTimeout(() => {
              icon.classList.remove('hidden');
              check.classList.add('hidden');
              label.textContent = originalText;
            }, 2000);
          }
        } catch (err) {
          console.error('Failed to copy to clipboard', err);
        }
      });
    });
  }

  // Setup on page load and view transitions
  setupCopyButtons();
  document.addEventListener('astro:page-load', setupCopyButtons);
</script>
