---
import { formatStars } from '../lib/entries';
import Sparkline from './Sparkline.astro';

interface Props {
  entry: {
    data: {
      slug: string;
      type: 'mcp_server' | 'agent_skill' | 'agent_tool';
      name: string;
      tagline?: string;
      summary?: string;
      categories: string[];
      status?: 'active' | 'slowing' | 'dormant' | 'archived';
      signals: {
        stars: number;
        last_commit?: string;
        stars_delta_7d?: number;
        stars_growth_pct?: number;
        trending_score?: number;
        rank_current?: number;
        rank_delta?: number | null;
        sparkline_4w?: number[];
      };
      source: {
        repo: string;
        official_vendor?: boolean;
        license?: string;
      };
      skill?: {
        is_pack_primary?: boolean;
        pack_total_skills?: number;
      };
      tool?: {
        subcategory?: string;
      };
    };
  };
  class?: string;
  packSkillsCount?: number;
  packSkillNames?: string[];
}

const { entry, class: className = '', packSkillsCount, packSkillNames } = Astro.props;
const data = entry.data;
const href =
  data.type === 'mcp_server'
    ? `/mcp/${data.slug}`
    : data.type === 'agent_tool'
    ? `/tools/${data.slug}`
    : `/skills/${data.slug}`;

const [owner, repoName] = data.source.repo.split('/');
const avatarUrl = `https://github.com/${owner}.png?size=64`;

const categoryNames: Record<string, string> = {
  'coding-agents': 'Coding & dev',
  'browser-web': 'Browser & web',
  'databases-memory': 'Databases & memory',
  'agent-frameworks': 'Frameworks',
  'productivity-ops': 'Productivity',
  'cloud-infra': 'Cloud & DevOps',
  'media-creative': 'Media & creative',
  'security-auth': 'Security',
  'domain-research': 'Research & domain',
  'other': 'Other utilities',
};

const primaryCategory = data.categories[0] || 'other';
const categoryLabel = categoryNames[primaryCategory] || primaryCategory;

const statusColors: Record<string, string> = {
  active: 'bg-emerald-500',
  slowing: 'bg-amber-500',
  dormant: 'bg-slate-400',
  archived: 'bg-slate-400',
};
const statusDotColor = statusColors[data.status || 'active'] || 'bg-emerald-500';
const statusText = data.status ? data.status.charAt(0).toUpperCase() + data.status.slice(1) : 'Active';

const delta7d = data.signals?.stars_delta_7d || 0;
const sparklinePoints = data.signals?.sparkline_4w || [];
const totalPackSkills = packSkillsCount ?? data.skill?.pack_total_skills ?? 1;
const isSkillPack = data.type === 'agent_skill' && totalPackSkills > 1;
const displayName = isSkillPack && repoName ? repoName : data.name;
---

<a
  href={href}
  class:list={[
    'group flex flex-col justify-between p-5 rounded-xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-xs transition-all duration-150 text-left',
    className
  ]}
>
  <div>
    <!-- Top Row: Avatar, Name, Owner, Type pill & Pack Badge -->
    <div class="flex items-start justify-between gap-3 mb-3">
      <div class="flex items-start gap-3 min-w-0">
        <img
          src={avatarUrl}
          alt={`${owner} avatar`}
          class="w-10 h-10 rounded-lg border border-slate-200 bg-slate-50 object-cover shrink-0"
          loading="lazy"
        />
        <div class="min-w-0">
          <h3 class="text-base font-semibold text-slate-900 group-hover:text-blue-600 transition-colors truncate">
            {displayName}
          </h3>
          <p class="text-xs text-slate-500 font-mono truncate">
            {owner}
          </p>
          {isSkillPack && packSkillNames && packSkillNames.length > 0 && (
            <p class="text-[11px] text-amber-800 font-normal truncate mt-0.5" title={packSkillNames.join(', ')}>
              Includes: {packSkillNames.slice(0, 3).join(', ')}{packSkillNames.length > 3 ? ` +${packSkillNames.length - 3} more` : ''}
            </p>
          )}
        </div>
      </div>

      <div class="flex flex-col items-end gap-1 shrink-0">
        <span
          class:list={[
            'px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wider rounded shrink-0',
            data.type === 'mcp_server'
              ? 'bg-blue-50 text-blue-700 border border-blue-200'
              : data.type === 'agent_tool'
              ? 'bg-purple-50 text-purple-700 border border-purple-200'
              : 'bg-teal-50 text-teal-700 border border-teal-200'
          ]}
        >
          {data.type === 'mcp_server' ? 'MCP server' : data.type === 'agent_tool' ? 'Agent tool' : 'Agent skill'}
        </span>

        {isSkillPack && (
          <span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-amber-50 text-amber-800 border border-amber-200 inline-flex items-center gap-1">
            <span>📦</span>
            <span>Pack ({totalPackSkills})</span>
          </span>
        )}
      </div>
    </div>

    <!-- 3-line Description / Summary (Understanding first per §5.4) -->
    <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed mb-4">
      {data.summary || data.tagline || 'Open tool integration.'}
    </p>
  </div>

  <!-- Bottom Signals: Category · ★ stars · Velocity badge · Sparkline · ● Status -->
  <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500 font-sans gap-2">
    <div class="flex items-center gap-1.5 truncate">
      <span class="text-slate-700 font-medium truncate">{categoryLabel}</span>
      <span class="text-slate-300">·</span>
      <span class="text-slate-800 font-mono font-medium">★ {formatStars(data.signals.stars)}</span>
      
      {delta7d > 0 && (
        <>
          <span class="text-slate-300">·</span>
          <span class="inline-flex items-center gap-0.5 px-1.5 py-0.2 rounded font-mono font-medium text-[11px] bg-orange-50 text-orange-700 border border-orange-200" title="7-day star gain">
            <span>+{delta7d > 999 ? formatStars(delta7d) : delta7d}</span>
            <span class="text-[9px]">/wk</span>
          </span>
        </>
      )}

      <span class="text-slate-300">·</span>
      <span class="inline-flex items-center gap-1 text-slate-600">
        <span class:list={['w-1.5 h-1.5 rounded-full inline-block', statusDotColor]}></span>
        <span>{statusText}</span>
      </span>
      {data.source.official_vendor && (
        <>
          <span class="text-slate-300">·</span>
          <span class="text-blue-700 font-medium">Official</span>
        </>
      )}
    </div>

    <!-- Sparkline preview -->
    {sparklinePoints.length >= 2 && (
      <div class="shrink-0 hidden sm:block" title="4-week trend">
        <Sparkline points={sparklinePoints} width={48} height={14} strokeWidth={1.5} />
      </div>
    )}
  </div>
</a>
