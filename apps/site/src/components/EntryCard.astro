---
import { formatStars } from '../lib/entries';

interface Props {
  entry: {
    data: {
      slug: string;
      type: 'mcp_server' | 'agent_skill';
      name: string;
      tagline?: string;
      summary?: string;
      categories: string[];
      status?: 'active' | 'slowing' | 'dormant' | 'archived';
      signals: {
        stars: number;
        last_commit?: string;
      };
      source: {
        repo: string;
        official_vendor?: boolean;
        license?: string;
      };
    };
  };
  class?: string;
}

const { entry, class: className = '' } = Astro.props;
const data = entry.data;
const isMcp = data.type === 'mcp_server';
const href = isMcp ? `/mcp/${data.slug}` : `/skills/${data.slug}`;

const [owner] = data.source.repo.split('/');
const avatarUrl = `https://github.com/${owner}.png?size=64`;

const categoryNames: Record<string, string> = {
  'dev-tools': 'Developer tools',
  'productivity': 'Productivity',
  'ai-frameworks': 'AI frameworks',
  'security': 'Security',
  'databases': 'Databases',
  'browser-automation': 'Browser automation',
  'other': 'Other utilities',
};

const primaryCategory = data.categories[0] || 'other';
const categoryLabel = categoryNames[primaryCategory] || primaryCategory;

const statusColors: Record<string, string> = {
  active: 'bg-emerald-500',
  slowing: 'bg-amber-500',
  dormant: 'bg-slate-400',
  archived: 'bg-slate-400',
};
const statusDotColor = statusColors[data.status || 'active'] || 'bg-emerald-500';
const statusText = data.status ? data.status.charAt(0).toUpperCase() + data.status.slice(1) : 'Active';
---

<a
  href={href}
  class:list={[
    'group flex flex-col justify-between p-5 rounded-xl border border-slate-200 bg-white hover:border-slate-300 hover:shadow-xs transition-all duration-150 text-left',
    className
  ]}
>
  <div>
    <!-- Top Row: Avatar, Name, Owner, Type pill -->
    <div class="flex items-start justify-between gap-3 mb-3">
      <div class="flex items-start gap-3 min-w-0">
        <img
          src={avatarUrl}
          alt={`${owner} avatar`}
          class="w-10 h-10 rounded-lg border border-slate-200 bg-slate-50 object-cover shrink-0"
          loading="lazy"
        />
        <div class="min-w-0">
          <h3 class="text-base font-semibold text-slate-900 group-hover:text-blue-600 transition-colors truncate">
            {data.name}
          </h3>
          <p class="text-xs text-slate-500 font-mono truncate">
            {owner}
          </p>
        </div>
      </div>

      <span
        class:list={[
          'px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wider rounded shrink-0',
          isMcp
            ? 'bg-blue-50 text-blue-700 border border-blue-200'
            : 'bg-teal-50 text-teal-700 border border-teal-200'
        ]}
      >
        {isMcp ? 'MCP server' : 'Agent skill'}
      </span>
    </div>

    <!-- 3-line Description / Summary (Understanding first per §5.4) -->
    <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed mb-4">
      {data.summary || data.tagline || 'Open tool integration.'}
    </p>
  </div>

  <!-- Bottom Signals: Category · ★ stars · ● Status · Official -->
  <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs text-slate-500 font-sans">
    <div class="flex items-center gap-1.5 truncate">
      <span class="text-slate-700 font-medium truncate">{categoryLabel}</span>
      <span class="text-slate-300">·</span>
      <span class="text-slate-800 font-mono font-medium">★ {formatStars(data.signals.stars)}</span>
      <span class="text-slate-300">·</span>
      <span class="inline-flex items-center gap-1 text-slate-600">
        <span class:list={['w-1.5 h-1.5 rounded-full inline-block', statusDotColor]}></span>
        <span>{statusText}</span>
      </span>
      {data.source.official_vendor && (
        <>
          <span class="text-slate-300">·</span>
          <span class="text-blue-700 font-medium">Official</span>
        </>
      )}
    </div>
  </div>
</a>
