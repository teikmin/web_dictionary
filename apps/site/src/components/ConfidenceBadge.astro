---
import type { LaunchConfidence } from '@web-db/schema';

interface Props {
  confidence?: LaunchConfidence;
  class?: string;
}

const { confidence = 'manifest', class: className = '' } = Astro.props;

const config = {
  registry: {
    label: 'From the official registry',
    bg: 'bg-emerald-50 border-emerald-200 text-emerald-800',
    dot: 'bg-emerald-500',
    title: 'Extracted directly from official MCP registry manifest',
  },
  manifest: {
    label: 'From the package file',
    bg: 'bg-blue-50 border-blue-200 text-blue-800',
    dot: 'bg-blue-500',
    title: 'Parsed directly from repository package manifest (package.json, pyproject.toml)',
  },
  readme: {
    label: 'From the README. Check before use',
    bg: 'bg-amber-50 border-amber-200 text-amber-800',
    dot: 'bg-amber-500',
    title: 'Heuristically extracted from README code blocks; verify configuration before use',
  },
  none: {
    label: 'No install command found. See the repository',
    bg: 'bg-slate-100 border-slate-200 text-slate-700',
    dot: 'bg-slate-400',
    title: 'No install command found. Refer to upstream repository documentation.',
  },
}[confidence] || {
  label: 'Unknown',
  bg: 'bg-slate-100 border-slate-200 text-slate-600',
  dot: 'bg-slate-400',
  title: 'Unknown configuration confidence',
};
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-medium border shadow-xs',
    config.bg,
    className,
  ]}
  title={config.title}
>
  <span class:list={['w-1.5 h-1.5 rounded-full', config.dot]} aria-hidden="true"></span>
  <span>{config.label}</span>
</span>
