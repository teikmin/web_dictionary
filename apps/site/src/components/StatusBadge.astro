---
import type { EntryStatus } from '@web-db/schema';

interface Props {
  status?: EntryStatus;
  class?: string;
}

const { status = 'active', class: className = '' } = Astro.props;

const styles: Record<EntryStatus, { label: string; bg: string; dot: string }> = {
  active: {
    label: 'Active',
    bg: 'bg-emerald-50 text-emerald-800 border-emerald-200',
    dot: 'bg-emerald-500',
  },
  slowing: {
    label: 'Slowing',
    bg: 'bg-amber-50 text-amber-800 border-amber-200',
    dot: 'bg-amber-500',
  },
  dormant: {
    label: 'Dormant',
    bg: 'bg-slate-100 text-slate-700 border-slate-200',
    dot: 'bg-slate-400',
  },
  archived: {
    label: 'Archived',
    bg: 'bg-slate-100 text-slate-600 border-slate-300',
    dot: 'bg-slate-400',
  },
};

const current = styles[status] || styles.active;
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md text-xs font-medium border',
    current.bg,
    className,
  ]}
>
  <span class:list={['w-1.5 h-1.5 rounded-full', current.dot]} aria-hidden="true"></span>
  <span>{current.label}</span>
</span>
