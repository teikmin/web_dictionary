---
interface Props {
  points?: number[];
  width?: number;
  height?: number;
  strokeWidth?: number;
  color?: string;
  class?: string;
  showPoints?: boolean;
}

const {
  points = [],
  width = 64,
  height = 20,
  strokeWidth = 1.5,
  color,
  class: className = '',
  showPoints = false,
} = Astro.props;

const w = Number.isFinite(width) ? Math.max(10, width) : 64;
const h = Number.isFinite(height) ? Math.max(10, height) : 20;
const pad = Math.min(2, Math.floor(Math.min(w, h) / 4));
const usableW = Math.max(1, w - 2 * pad);
const usableH = Math.max(1, h - 2 * pad);

// Calculate min/max with fallback for null or non-array points
const pointsList = Array.isArray(points) ? points : [];
const validPoints = pointsList.filter((p) => typeof p === 'number' && Number.isFinite(p));
const count = validPoints.length;

let isFlatline = false;
let pointsString = '';
let lastPoint: [number, number] | null = null;

if (count >= 2) {
  const min = Math.min(...validPoints);
  const max = Math.max(...validPoints);

  // Divide-by-zero guard for flatline trends (max === min)
  if (max === min) {
    isFlatline = true;
    const midY = (h / 2).toFixed(1);
    pointsString = `${pad},${midY} ${(w - pad).toFixed(1)},${midY}`;
    lastPoint = [w - pad, h / 2];
  } else {
    pointsString = validPoints
      .map((p, i) => {
        const x = pad + (i / (count - 1)) * usableW;
        const y = h - pad - ((p - min) / (max - min)) * usableH;
        if (i === count - 1) {
          lastPoint = [x, y];
        }
        return `${x.toFixed(1)},${y.toFixed(1)}`;
      })
      .join(' ');
  }
} else if (count === 1) {
  isFlatline = true;
  const midY = (h / 2).toFixed(1);
  pointsString = `${pad},${midY} ${(w - pad).toFixed(1)},${midY}`;
  lastPoint = [w - pad, h / 2];
}

// Trend direction coloring
const isPositive = count >= 2 && validPoints[count - 1] > validPoints[0];
const isNegative = count >= 2 && validPoints[count - 1] < validPoints[0];

const defaultColorClass = isPositive
  ? 'text-emerald-500'
  : isNegative
  ? 'text-rose-500'
  : 'text-slate-400';

const strokeColorClass = color || defaultColorClass;
---

{count === 0 ? (
  <svg
    class:list={['inline-block overflow-visible', strokeColorClass, className]}
    width={w}
    height={h}
    viewBox={`0 0 ${w} ${h}`}
    aria-hidden="true"
  >
    <polyline
      points={`${pad},${(h / 2).toFixed(1)} ${(w - pad).toFixed(1)},${(h / 2).toFixed(1)}`}
      fill="none"
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-dasharray="2 2"
      stroke-opacity="0.4"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
) : isFlatline ? (
  <svg
    class:list={['inline-block overflow-visible', strokeColorClass, className]}
    width={w}
    height={h}
    viewBox={`0 0 ${w} ${h}`}
    aria-label="Flatline trend"
    role="img"
  >
    <polyline
      points={pointsString}
      fill="none"
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-dasharray="3 2"
      stroke-linecap="round"
      stroke-linejoin="round"
      opacity="0.6"
    />
    {showPoints && lastPoint && (
      <circle
        cx={lastPoint[0].toFixed(1)}
        cy={lastPoint[1].toFixed(1)}
        r="2"
        fill="currentColor"
      />
    )}
  </svg>
) : (
  <svg
    class:list={['inline-block overflow-visible', strokeColorClass, className]}
    width={w}
    height={h}
    viewBox={`0 0 ${w} ${h}`}
    aria-label={`Weekly star sparkline trend: ${validPoints.join(' -> ')}`}
    role="img"
  >
    <polyline
      points={pointsString}
      fill="none"
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    {showPoints && lastPoint && (
      <circle
        cx={lastPoint[0].toFixed(1)}
        cy={lastPoint[1].toFixed(1)}
        r="2"
        fill="currentColor"
      />
    )}
  </svg>
)}
