# AI Tools Hub — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# -------------------------------------------------------
# Supabase (get from: supabase.com -> your project -> Settings -> API)
# -------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# -------------------------------------------------------
# GitHub (get from: github.com -> Settings -> Developer settings -> Personal access tokens -> Tokens (classic))
# Required scopes: public_repo (read-only is fine)
# -------------------------------------------------------
GITHUB_TOKEN=ghp_YOUR_TOKEN_HERE
